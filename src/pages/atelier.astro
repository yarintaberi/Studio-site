---
import Base from '../layouts/Base.astro';
---
<Base title="האטלייה">
  <section class="about" style="padding-top:calc(84px + env(safe-area-inset-top,0px))">
    <div class="about-media" data-parallax><img loading="lazy" decoding="async" src="/images/window.webp" alt="חלון קשתי ואור על קיר טיח באטלייה"></div>
    <div class="about-text">
      <p class="eyebrow" style="margin:0">THE DESIGNER</p>
      <h1 data-reveal style="font-family:var(--hebrew);font-size:clamp(34px,4vw,54px)">האטלייה</h1>
      <p data-reveal>[פסקה על Yarin: הסיפור, ההכשרה, מה מוביל אותה בעיצוב]</p>
      <p data-reveal>[מה מבדיל את האטלייה, במשפט אחד]</p>
      <p class="sign">Yarin Taberi</p>
    </div>
  </section>
  <section class="details" aria-label="פרטי עבודת יד" style="padding-top:6px">
    <figure data-reveal="mask"><img loading="lazy" decoding="async" src="/images/beading.webp" alt="רקמת חרוזים"><figcaption>Beading</figcaption></figure>
    <figure data-reveal="mask"><img loading="lazy" decoding="async" src="/images/back-detail.webp" alt="שולי תחרה"><figcaption>Lace edge</figcaption></figure>
    <figure data-reveal="mask"><img loading="lazy" decoding="async" src="/images/skirt.webp" alt="טול ופרחים תפורים"><figcaption>Tulle &amp; florals</figcaption></figure>
    <figure data-reveal="mask"><img loading="lazy" decoding="async" src="/images/profile.webp" alt="צווארון הולטר"><figcaption>Halter neck</figcaption></figure>
  </section>
  <div style="height:clamp(80px,10vw,130px)"></div>
</Base>
